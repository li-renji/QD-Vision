# ===== ClipCut Web 环境变量示例 =====
# 复制为 packages/app/.env.local 后按需填写。**全部可以留空**：
# 留空时应用依然可以完成「导入 → 剪辑 → 导出」的完整闭环。
#
# 安全提示：任何 Key 都只保存在你自己的浏览器 IndexedDB 中，不会上传到 ClipCut 官方。

# 内置素材库（P1 · FR-011）——用户自带 Key，仓库不提供公共 Key
VITE_PIXABAY_API_KEY=
VITE_FREESOUND_API_KEY=

# AI Provider 默认配置（可在设置面板中覆盖）
# VITE_AI_DEFAULT_BASE_URL=
# VITE_AI_DEFAULT_MODEL=

# MCP 本地通道（V1.0 仅骨架，Node 端做 WebSocket host）
VITE_MCP_WS_URL=ws://localhost:8765
VITE_MCP_TOKEN=
