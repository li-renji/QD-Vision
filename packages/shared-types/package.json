{
  "name": "@clipcut/shared-types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QD视界 跨包类型与协议（零运行时依赖）",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root . --reporter=default --reporter=json --outputFile=./test-results.json",
    "test:watch": "vitest --root ."
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
