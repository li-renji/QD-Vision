{
  "name": "@clipcut/mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QD视界 MCP Server 骨架（stdio + WebSocket 本地通道）",
  "license": "MIT",
  "bin": {
    "clipcut-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@clipcut/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "typescript": "^5.7.2"
  }
}
